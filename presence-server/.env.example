# Copy to .env and fill in. The systemd unit loads this file via EnvironmentFile.
# Generate the token with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Every Plan Runner client must send this exact same value. The server refuses to start without it.
PRESENCE_TOKEN=

# Port to listen on. Default 8787 if unset.
PORT=8787
